ADMIN_EMAIL=Admin@gmail.com
# Generate a bcrypt hash for Admin@123 with the command in Backend/README.md.
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
# Comma-separated frontend origins when the UI is hosted on another origin.
# FRONTEND_ORIGIN=http://localhost:5173